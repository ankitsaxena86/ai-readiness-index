{
  "name": "widget-toolkit",
  "version": "1.2.0",
  "description": "A small, well-documented toolkit for composing and validating widgets.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "kleur": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "eslint": "9.7.0",
    "typescript": "5.5.3",
    "vitest": "2.0.3"
  }
}
